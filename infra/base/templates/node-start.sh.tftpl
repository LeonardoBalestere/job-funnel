#!/bin/bash
# Runs once on every new node instance (EC2 user data). It re-attaches the fixed address and the
# data volume, mounts the volume, and installs k3s with all of its state on the volume.
# Rendered by Terraform: values in dollar-brace form are filled in, plain shell variables are not.
set -euo pipefail
exec > >(tee -a /var/log/job-funnel-node-start.log) 2>&1

REGION="${region}"
VOLUME_ID="${volume_id}"
ALLOCATION_ID="${allocation_id}"
DATA_MOUNT=/data
export AWS_DEFAULT_REGION="$REGION"

log() { echo "$(date -u +%FT%TZ) $*"; }

# Retries a command every 10 seconds, up to the given number of attempts.
retry() {
  local attempts=$1 n=1
  shift
  until "$@"; do
    if [ "$n" -ge "$attempts" ]; then
      log "giving up after $n attempts: $*"
      return 1
    fi
    n=$((n + 1))
    sleep 10
  done
}

imds() {
  local token
  token=$(curl -sSf -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
  curl -sSf -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

INSTANCE_ID=$(imds instance-id)
log "starting node instance $INSTANCE_ID"

# The Ubuntu image ships the Systems Manager agent but not the AWS CLI.
retry 30 snap install aws-cli --classic
aws() { /snap/bin/aws "$@"; }

# --- Fixed address ------------------------------------------------------------------------------
# Re-association takes the address from a previous instance that has not finished terminating.
# The launch-time public address goes away with it, so later calls retry while the route settles.
log "associating address $ALLOCATION_ID"
retry 30 aws ec2 associate-address --allocation-id "$ALLOCATION_ID" --instance-id "$INSTANCE_ID" --allow-reassociation

# --- Data volume --------------------------------------------------------------------------------
# A volume attaches to one instance at a time: wait, for up to an hour, for the previous instance
# to release it.
attach_data_volume() {
  local state attached_to
  state=$(aws ec2 describe-volumes --volume-ids "$VOLUME_ID" --query 'Volumes[0].State' --output text) || return 1
  attached_to=$(aws ec2 describe-volumes --volume-ids "$VOLUME_ID" --query 'Volumes[0].Attachments[0].InstanceId' --output text) || return 1

  if [ "$attached_to" = "$INSTANCE_ID" ]; then
    return 0
  fi
  if [ "$state" = "available" ]; then
    log "attaching volume $VOLUME_ID"
    aws ec2 attach-volume --volume-id "$VOLUME_ID" --instance-id "$INSTANCE_ID" --device /dev/sdf >/dev/null || return 1
    return 0
  fi
  log "volume $VOLUME_ID is $state, attached to $attached_to; waiting"
  return 1
}
retry 360 attach_data_volume

# On Nitro instances the volume appears as an NVMe device whose serial is the volume id.
DEVICE="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VOLUME_ID//-/}"
retry 60 test -b "$DEVICE"

# Formats only a volume that has no file system yet, which happens once, on the first start.
if [ -z "$(blkid -o value -s TYPE "$DEVICE" || true)" ]; then
  log "formatting the new data volume"
  mkfs.ext4 -L job-funnel-data "$DEVICE"
fi

mkdir -p "$DATA_MOUNT"
UUID=$(blkid -o value -s UUID "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID $DATA_MOUNT ext4 defaults,nofail 0 2" >>/etc/fstab
mountpoint -q "$DATA_MOUNT" || mount "$DATA_MOUNT"

# /etc/rancher holds the node's password and the k3s configuration. Keeping it on the volume lets
# a new instance register as the same node, so volumes bound to the node stay schedulable.
mkdir -p "$DATA_MOUNT/etc-rancher" /etc/rancher
grep -q " /etc/rancher " /etc/fstab ||
  echo "$DATA_MOUNT/etc-rancher /etc/rancher none bind,nofail,x-systemd.requires-mounts-for=$DATA_MOUNT 0 0" >>/etc/fstab
mountpoint -q /etc/rancher || mount /etc/rancher

# --- k3s ----------------------------------------------------------------------------------------
mkdir -p /etc/rancher/k3s
cat >/etc/rancher/k3s/config.yaml <<'CONFIG'
node-name: ${node_name}
data-dir: /data/k3s
write-kubeconfig-mode: "0600"
CONFIG

# k3s must never start on the root volume, after a reboot or otherwise.
mkdir -p /etc/systemd/system/k3s.service.d
cat >/etc/systemd/system/k3s.service.d/data-volume.conf <<UNIT
[Unit]
RequiresMountsFor=$DATA_MOUNT /etc/rancher
UNIT

log "installing k3s from channel ${k3s_channel}"
curl -sSfL --retry 10 --retry-all-errors -o /tmp/k3s-install.sh https://get.k3s.io
retry 10 env INSTALL_K3S_CHANNEL="${k3s_channel}" sh /tmp/k3s-install.sh

log "node started"
